# Configurações do Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Configurações de Autenticação (NextAuth.js)
NEXTAUTH_URL="https://wehosthere.com"
NEXTAUTH_SECRET="your-nextauth-secret-key"

# Configurações de API (usar string vazia para URLs relativas em produção)
NEXT_PUBLIC_API_URL=""
NEXT_PUBLIC_SITE_URL="https://wehosthere.com"
