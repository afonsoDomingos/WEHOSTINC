# Configurações de Banco de Dados (para produção)
DATABASE_URL="postgresql://user:password@localhost:5432/wehosthere"

# Configurações de Autenticação (NextAuth.js)
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-secret-key-here"

# Configurações de Email (para produção)
SMTP_HOST="smtp.wehosthere.com"
SMTP_PORT="587"
SMTP_USER="noreply@wehosthere.com"
SMTP_PASSWORD="your-smtp-password"

# Configurações de Pagamento (Stripe)
STRIPE_PUBLIC_KEY="pk_test_your_key"
STRIPE_SECRET_KEY="sk_test_your_key"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret"

# Configurações de Hospedagem (DigitalOcean/DO API)
DIGITALOCEAN_TOKEN="your-do-token"
DIGITALOCEAN_SPACES_KEY="your-spaces-key"
DIGITALOCEAN_SPACES_SECRET="your-spaces-secret"

# Configurações de CDN
CDN_URL="https://cdn.wehosthere.com"

# Configurações de SSL
LETSENCRYPT_EMAIL="admin@wehosthere.com"

# Ambiente
NODE_ENV="development"
